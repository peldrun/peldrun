{
  "id": "source_control",
  "name": "Source Control",
  "description": "Unified interface for interacting with Git repositories. WORKFLOW: 1. Call 'create_workspace' with 'repository_id'. 2. Edit files locally. 3. Call 'request_approval' with the 'workspace_id' returned from step 1. Do NOT use http_fetch or bash for Git operations. All remote writes require explicit human approval via the UI.",
  "category": "system",
  "safety_level": "safe",
  "is_builtin": true,
  "is_enabled": true,
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create_workspace",
          "list_repositories",
          "read_file",
          "create_branch",
          "inspect_diff",
          "run_checks",
          "request_approval",
          "push_branch",
          "create_change_request"
        ],
        "description": "The source-control action to execute."
      },
      "params": {
        "type": "object",
        "description": "Optional structured parameter bag.",
        "additionalProperties": true
      },
      "repository_id": {
        "type": "string",
        "description": "Stable provider repository identifier (e.g., 'owner/repo'). Required for 'create_workspace'."
      },
      "provider": {
        "type": "string",
        "enum": ["github", "gitlab", "bitbucket"],
        "description": "Provider to use. Defaults to 'github'."
      },
      "account_id": {
        "type": "string",
        "description": "Optional stable account ID."
      },
      "file_path": {
        "type": "string",
        "description": "Repository-relative file path (required for 'read_file')."
      },
      "ref": {
        "type": "string",
        "description": "Branch, tag, or commit SHA to read from."
      },
      "workspace_id": {
        "type": "string",
        "description": "Local workspace ID returned by 'create_workspace'. Required for 'create_branch', 'inspect_diff', 'run_checks', and 'request_approval'."
      },
      "branch_name": {
        "type": "string",
        "description": "Branch name to create (required for 'create_branch')."
      },
      "from_sha": {
        "type": "string",
        "description": "Optional starting commit SHA for 'create_branch'."
      },
      "base_sha": {
        "type": "string",
        "description": "Base commit SHA to diff against."
      },
      "include_patch": {
        "type": "boolean",
        "description": "Include per-file diff text in 'inspect_diff' output."
      },
      "checks": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Names of pre-registered checks to run."
      },
      "fail_fast": {
        "type": "boolean",
        "description": "Stop after the first failing check."
      },
      "operation_id": {
        "type": "string",
        "description": "Operation ID. Required for 'push_branch' and 'create_change_request'. Optional for 'request_approval' if 'workspace_id' is provided."
      },
      "operation": {
        "type": "string",
        "enum": ["push_branch", "create_change_request"],
        "default": "push_branch",
        "description": "The operation to request approval for. Defaults to 'push_branch'."
      },
      "target_branch": {
        "type": "string",
        "default": "main",
        "description": "Target branch (required for 'request_approval'). Defaults to 'main'."
      },
      "approval_id": {
        "type": "string",
        "description": "Approval ticket ID (required for 'push_branch' and 'create_change_request')."
      },
      "remote": {
        "type": "string",
        "description": "Remote name (optional for 'push_branch')."
      },
      "local_branch": {
        "type": "string",
        "description": "Local branch to push."
      },
      "source_branch": {
        "type": "string",
        "description": "Source branch (required for 'create_change_request')."
      },
      "title": {
        "type": "string",
        "description": "Change-request title. ONLY used for 'create_change_request'."
      },
      "body": {
        "type": "string",
        "description": "Change-request description. ONLY used for 'create_change_request'."
      },
      "draft": {
        "type": "boolean",
        "default": true,
        "description": "Create as draft change request. ONLY used for 'create_change_request'."
      }
    },
    "required": ["action"]
  }
}
