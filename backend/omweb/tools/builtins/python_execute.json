  "settings": {
    "enabled": true,
    "schema": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 60
        },
        "max_output_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000,
          "default": 20000
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "timeout_seconds": 60,
      "max_output_chars": 20000
    },
    "required": []
  },

  "permissions": ["sandbox:execute"],
  "network_access": false,
  "requires_api_key": false,
  "required_env_vars": [],
  "sandbox": true,
  "filesystem_access": "ephemeral",
  "rate_limit": {
    "requests": 120,
    "window_seconds": 60
  },

  "timeout_seconds": 60,
  "concurrency": 1,
  "runtime": "python:3.11-sandbox",
  "entry_point": "python_execute.handler",
  "dependencies": [],

  "examples": [
    {
      "input": { "code": "x = 21\nprint(x * 2)" },
      "output_preview": "42"
    },
    {
      "input": { "code": "import math\nprint(math.sqrt(144))" },
      "output_preview": "12.0"
    }
  ],
  "usage_notes": "Execution state persists across calls within the same session. Prefer printing results explicitly; stdout/stderr are returned as part of the tool output. No network access is available inside the sandbox.",

