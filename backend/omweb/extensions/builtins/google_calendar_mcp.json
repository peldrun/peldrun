  "badges": ["official", "verified", "remote", "requires-oauth", "read-only", "developer-preview"],
  "usage_hint": "Calendar MCP exposes read-only tools by default. WORKFLOW: (1) When the user asks about their schedule, call calendar_list_events with timeMin/timeMax in RFC 3339 (e.g. '2026-11-01T00:00:00Z') and optionally calendarId. Default calendarId is 'primary'. (2) Call calendar_get_event with the eventId for full details (attendees, RSVP status, conference links). (3) Call calendar_find_free_time with a list of calendarIds and a duration to locate open slots. (4) Call calendar_list_calendars when the user asks which calendars are shared with them. Adding the 'calendar.events' scope enables create/update tools. Times are always in the calendar's timezone unless timeZone is overridden in the request.",
  "hints": { "setup_time": "30 minutes", "requires_account": true, "requires_token": false, "cost": "free", "data_access": "read-only", "network_access": true, "rate_limit": "Google Workspace per-user quotas" }
