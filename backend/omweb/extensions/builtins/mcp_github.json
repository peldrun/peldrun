  "version": "1.0.0",
  "release_date": "2025-01-15",
  "stability": "stable",
  "min_app_version": "2.4.0",
  "lifecycle_status": "active",

  "is_builtin": true,
  "read_only": false,
  "command": "npx -y @modelcontextprotocol/server-github",
  "transport": "stdio",
  "runtime": "node",
  "auth_strategy": "env",
  "hosting_type": "local",

  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  },
  "tool_count": 26,

  "badges": ["official", "verified", "requires-token", "writes-data"],

  "env_schema": {
    "type": "object",
    "required": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
    "properties": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": {
        "type": "string",
        "title": "GitHub Personal Access Token",
        "description": "Classic PAT needs 'repo' for write ops, 'public_repo' for read-only. Fine-grained: 'Contents: Read and write'. Create at https://github.com/settings/tokens",
        "secret": true
      }
    }
  },

  "hints": {
    "setup_time": "1 minute",
    "requires_account": true,
    "requires_token": true,
    "cost": "free",
    "data_access": "read-write",
    "network_access": true,
    "rate_limit": "5,000 req/hour authenticated"
  }
