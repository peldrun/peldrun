{
  "version": "0.5.0",
  "root": "Stack",
  "components": [
    {
      "name": "Stack",
      "description": "Root layout container that stacks UI components vertically or horizontally.",
      "positionalArgs": ["children", "direction", "gap"],
      "schema": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "type": "any" }, "description": "Child component references" },
          "direction": { "type": "string", "enum": ["vertical", "horizontal"], "default": "vertical" },
          "gap": { "type": "string" }
        },
        "required": ["children"]
      }
    },
    {
      "name": "Grid",
      "description": "Responsive grid container for displaying components in multi-column layout.",
      "positionalArgs": ["children", "columns"],
      "schema": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "type": "any" }, "description": "Child component references" },
          "columns": { "type": "number", "default": 2 }
        },
        "required": ["children"]
      }
    },
    {
      "name": "Card",
      "description": "General container card with title, description, and optional nested markdown items.",
      "positionalArgs": ["title", "description", "items"],
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "Metric",
      "description": "Displays a numeric KPI metric with change magnitude and trend indicator.",
      "positionalArgs": ["label", "value", "change", "trend"],
      "schema": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "default": "Metric" },
          "value": { "type": ["string", "number"], "default": "0" },
          "change": { "type": "string" },
          "trend": { "type": "string", "enum": ["up", "down", "neutral"], "default": "neutral" }
        },
        "required": ["label", "value"]
      }
    },
    {
      "name": "Chart",
      "description": "Renders visual data analytics charts (bar, line, donut, area).",
      "positionalArgs": ["type", "title", "unit", "data"],
      "schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["bar", "line", "donut", "area"], "default": "bar" },
          "title": { "type": "string", "default": "Analytics" },
          "unit": { "type": "string" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "number" }
              },
              "required": ["label", "value"]
            }
          }
        },
        "required": ["type", "title", "data"]
      }
    },
    {
      "name": "Table",
      "description": "Renders tabular structured data with column headers and cell rows.",
      "positionalArgs": ["headers", "rows"],
      "schema": {
        "type": "object",
        "properties": {
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] } } }
        },
        "required": ["headers", "rows"]
      }
    },
    {
      "name": "Diagram",
      "description": "Renders visual flowcharts, architecture diagrams, and state machines via Mermaid syntax.",
      "positionalArgs": ["title", "code"],
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["code"]
      }
    },
    {
      "name": "MathPlot",
      "description": "Plots 2D mathematical curves and renders scientific LaTeX formulas.",
      "positionalArgs": ["title", "formula", "equation", "rangeX"],
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "formula": { "type": "string" },
          "equation": { "type": "string" },
          "rangeX": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "default": [-10, 10] }
        }
      }
    },
    {
      "name": "Alert",
      "description": "Displays a prominent message callout with severity coloring (info, success, warning, error).",
      "positionalArgs": ["type", "message"],
      "schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["info", "success", "warning", "error"], "default": "info" },
          "message": { "type": "string" }
        },
        "required": ["type", "message"]
      }
    },
    {
      "name": "Badge",
      "description": "Displays a compact status badge or service state indicator.",
      "positionalArgs": ["label", "variant"],
      "schema": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "variant": { "type": "string", "enum": ["info", "success", "warning", "error", "neutral"], "default": "neutral" }
        },
        "required": ["label"]
      }
    },
    {
      "name": "Progress",
      "description": "Visualizes task completion percentage or resource capacity.",
      "positionalArgs": ["label", "percentage"],
      "schema": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "default": "Progress" },
          "percentage": { "type": "number", "minimum": 0, "maximum": 100, "default": 0 }
        },
        "required": ["label", "percentage"]
      }
    },
    {
      "name": "Carousel",
      "description": "Displays multi-card showcases in an interactive swipeable slider.",
      "positionalArgs": ["title", "slides"],
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "slides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "content": { "type": "string" }
              },
              "required": ["title", "content"]
            }
          }
        },
        "required": ["slides"]
      }
    },
    {
      "name": "Accordion",
      "description": "Collapsible disclosure sections for progressive detail discovery.",
      "positionalArgs": ["items"],
      "schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" }
              },
              "required": ["title", "content"]
            }
          }
        },
        "required": ["items"]
      }
    },
    {
      "name": "TestResults",
      "description": "Displays automated test execution summary with passed, failed, and skipped metrics.",
      "positionalArgs": ["passed", "failed", "skipped"],
      "schema": {
        "type": "object",
        "properties": {
          "passed": { "type": "number", "default": 0 },
          "failed": { "type": "number", "default": 0 },
          "skipped": { "type": "number", "default": 0 }
        }
      }
    },
    {
      "name": "ActionButton",
      "description": "Interactive button triggering predefined agent workflows or tools.",
      "positionalArgs": ["label", "actionId"],
      "schema": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "actionId": { "type": "string" }
        },
        "required": ["label", "actionId"]
      }
    },
    {
      "name": "Form",
      "description": "Configurable user input form with typed controls and submit callback.",
      "positionalArgs": ["title", "fields", "submitLabel", "description"],
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "object" } },
          "submitLabel": { "type": "string", "default": "Submit" },
          "description": { "type": "string" }
        },
        "required": ["title", "fields"]
      }
    }
  ]
}
